# BolhaDev Digest — exemplo de variáveis de ambiente
# Copie para .env e preencha: cp .env.example .env

# --- Banco de dados (Neon Postgres, https://neon.tech) ---
# Use a string "pooled" do painel do Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Google Gemini — resumos da edição (grátis em https://aistudio.google.com/) ---
GEMINI_API_KEY="sua_chave_do_google_gemini"

# --- Segredo do cron da Vercel (gere com: openssl rand -hex 32) ---
# A Vercel envia Authorization: Bearer <CRON_SECRET> automaticamente
CRON_SECRET="gere_um_segredo_de_64_caracteres_hex"

# --- Telegram: token via @BotFather e ID do canal/grupo ---
TELEGRAM_BOT_TOKEN="123456:ABC-DEF_seu_token_do_botfather"
TELEGRAM_CHAT_ID="id_do_seu_canal_ou_grupo"

# --- Agendamento (fallback; o que você salvar na UI prevalece) ---
AUTO_SCHEDULE=true
SCHEDULE_TIME="09:17"

# --- Web Push opcional (gere as chaves com: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Webhook opcional de WhatsApp (Evolution API / Baileys) ---
WHATSAPP_WEBHOOK_URL=""

# --- Tweets REAIS da #bolhadev (opcional): token do Apify (https://apify.com) ---
# Com o token, a curadoria usa o actor danek/twitter-scraper (busca #bolhadev;
# funciona no plano free — limite de 20 results/run, custo ~US$0,11/mês).
# Sem o token (ou se o Apify falhar), a edição usa destaques reais e gratuitos
# da comunidade dev: Hacker News + DEV Community (sem chave nenhuma).
APIFY_API_TOKEN=""

# --- Filtro de autopromoção/anúncios da curadoria (opcional) ---
# Aplicado na coleta, ANTES de a edição ser montada (vale para o fallback
# nos dias sem cota do Gemini, que publica os itens brutos).
# Autores bloqueados (separe por vírgula, sem @):
CURATION_BLOCKLIST=""
# Termos promocionais (se preenchido, SUBSTITUI a lista default:
# rmt, topidle, heroesfarm, gameonline, mmorpg, "vamos fazer dinheiro",
# giveaway, sorteio). Match por palavra inteira, sem distinção de maiúsculas:
CURATION_FILTER_TERMS=""
# Máximo de itens por autor por edição (default 2):
CURATION_MAX_PER_AUTHOR=2

# --- Admin do painel (Basic Auth em /settings e nas APIs administrativas) ---
# Obrigatório: sem essas variáveis as rotas admin respondem 503 (fail-closed).
# Gere uma senha forte, ex.: openssl rand -base64 24
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="uma_senha_forte_unica"
